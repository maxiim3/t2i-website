---
import "../assets/app.css";
import SEO from "../components/SEO.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";

export interface Props {
	title?: string;
	description?: string;
	canonical?: string;
	og?: {
		title?: string;
		description?: string;
		image?: string;
		type?: string;
	};
	twitter?: {
		title?: string;
		description?: string;
		image?: string;
		card?: 'summary' | 'summary_large_image';
	};
	structuredData?: object;
	noindex?: boolean;
	hideHeader?: boolean;
	hideFooter?: boolean;
}

const { 
	title,
	description,
	canonical,
	og,
	twitter,
	structuredData,
	noindex = false,
	hideHeader = false,
	hideFooter = false
} = Astro.props;

// Get current path for navigation active states
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en" data-theme="brand">
	<head>
		<SEO 
			title={title}
			description={description}
			canonical={canonical}
			og={og}
			twitter={twitter}
			structuredData={structuredData}
			noindex={noindex}
		/>
	</head>
	<body class="min-h-screen bg-base-100 text-base-content flex flex-col">
		{!hideHeader && <Header currentPath={currentPath} />}
		
		<main class="flex-1">
			<slot />
		</main>
		
		{!hideFooter && <Footer />}
	</body>
</html>
