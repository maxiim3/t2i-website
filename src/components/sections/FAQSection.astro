---
import FAQItem from '../ui/FAQItem.astro';

// FAQ data structure - Restructured for trust and clarity
const faqData = [
  // Tier 1: Value First - Lead with what T2I does
  {
    question: "What does T2I do?",
    answer: `<p>T2I converts your text into professional image files instantly. Here's how it works:</p>
    <ol>
      <li>Type or paste your text</li>
      <li>Choose fonts, colors, and background options</li>
      <li>Download your image file (PNG format, with JPG and WebP coming soon)</li>
    </ol>
    <p>Perfect for social media graphics, website headers, presentations, and anywhere you need text as an image.</p>`,
    isProminent: true,
    id: "what-does-t2i-do"
  },
  {
    question: "How quickly can I create text images?",
    answer: `<p>Creating text images with T2I takes <strong>less than 30 seconds</strong>:</p>
    <ul>
      <li><strong>No account setup</strong> - Start immediately</li>
      <li><strong>Instant preview</strong> - See results as you type</li>
      <li><strong>One-click download</strong> - Get your image file instantly</li>
      <li><strong>No design skills needed</strong> - Just type and choose your style</li>
    </ul>
    <p>It's the fastest way to turn text into professional images.</p>`,
    isProminent: true,
    id: "creation-speed"
  },
  {
    question: "What can I create with T2I?",
    answer: `<p>T2I is perfect for creating:</p>
    <ul>
      <li><strong>Social Media Graphics</strong> - Quote posts, headers, story text</li>
      <li><strong>Business Materials</strong> - Simple logos, watermarks, branded text</li>
      <li><strong>Web Content</strong> - Headers, titles, call-out boxes</li>
      <li><strong>Presentations</strong> - Styled text that maintains formatting</li>
      <li><strong>Print Materials</strong> - Text elements with specific fonts</li>
      <li><strong>Content Creation</strong> - Thumbnails, titles, overlay text</li>
    </ul>`,
    isProminent: true,
    id: "creation-possibilities"
  },
  
  // Tier 2: Features & Access  
  {
    question: "What image formats are available?",
    answer: `<p>Currently available:</p>
    <ul>
      <li><strong>PNG</strong> - Perfect for transparent backgrounds, logos, and graphics</li>
    </ul>
    <p>Coming soon:</p>
    <ul>
      <li><strong>JPG</strong> - Optimized for smaller file sizes and social media</li>
      <li><strong>WebP</strong> - Modern format with best compression and quality</li>
    </ul>`,
    id: "supported-formats"
  },
  {
    question: "Is T2I free to use?",
    answer: `<p><strong>Yes, T2I is completely free to use.</strong> There are no:</p>
    <ul>
      <li>Account registration requirements</li>
      <li>Usage limits or quotas</li>
      <li>Watermarks on your images</li>
      <li>Premium features or paid tiers</li>
    </ul>
    <p>You can create unlimited images with full features at no cost.</p>`,
    id: "free-to-use"
  },
  {
    question: "Do I need to create an account?",
    answer: `<p><strong>No account required!</strong> T2I works immediately when you visit the site.</p>
    <p>Benefits of no account system:</p>
    <ul>
      <li>Start creating images instantly</li>
      <li>No personal information collected</li>
      <li>No email verification needed</li>
      <li>No password to remember</li>
    </ul>`,
    id: "no-account-needed"
  },
  
  // Tier 3: Natural Clarification
  {
    question: "How is T2I different from AI image generators?",
    answer: `<p>T2I is a text rendering utility, while AI image generators create artistic content:</p>
    <ul>
      <li><strong>T2I</strong>: Takes your text and renders it exactly as you typed it into an image format</li>
      <li><strong>AI Generators</strong>: Interpret text descriptions to create artistic images, photos, or drawings</li>
    </ul>
    <p>Think of T2I as a digital typography tool - you get exactly what you type, styled with fonts and colors you choose.</p>`,
    id: "difference-from-ai"
  },
  {
    question: "How does T2I convert text to images?",
    answer: `<p>T2I uses web browser technology to render text with your chosen styling (fonts, colors, backgrounds) onto a digital canvas, then exports that canvas as an image file.</p>
    <p>All processing happens locally in your browser - no servers involved. The text rendering uses the same technology that displays text on websites, ensuring high quality and accuracy.</p>`,
    id: "how-conversion-works"
  },
  
  
  // Tier 4: Trust & Security
  {
    question: "Can I use T2I for commercial projects?",
    answer: `<p><strong>Yes</strong>, T2I can be used for commercial projects. There are no restrictions on how you use the images you create.</p>
    <p>However, remember that you're responsible for:</p>
    <ul>
      <li>Using fonts you have proper licenses for</li>
      <li>Not infringing on copyrighted text content</li>
      <li>Following any trademark guidelines for brand names</li>
    </ul>`,
    id: "commercial-use"
  },
  {
    question: "Is my data private and secure?",
    answer: `<p><strong>Your privacy is fully protected.</strong> Here's how:</p>
    <ul>
      <li>All text processing happens in your browser locally</li>
      <li>No text content is sent to our servers</li>
      <li>No images are stored or transmitted</li>
      <li>No tracking or analytics on your content</li>
      <li>No account data since no accounts are required</li>
    </ul>
    <p>What you type stays on your device.</p>`,
    id: "privacy-security"
  },
  {
    question: "What browsers does T2I support?",
    answer: `<p>T2I works on all modern browsers:</p>
    <ul>
      <li><strong>Desktop</strong>: Chrome, Firefox, Safari, Edge (latest versions)</li>
      <li><strong>Mobile</strong>: iOS Safari, Chrome for Android</li>
      <li><strong>Tablets</strong>: iPad Safari, Android Chrome</li>
    </ul>
    <p>For best results, use an updated browser version. Internet Explorer is not supported.</p>`,
    id: "browser-support"
  },
  {
    question: "How can I get help or report issues?",
    answer: `<p>If you need assistance:</p>
    <ul>
      <li><strong>Check this FAQ</strong> - Most questions are answered here</li>
      <li><strong>Try refreshing</strong> - Solves most temporary issues</li>
      <li><strong>Update your browser</strong> - Ensures compatibility</li>
      <li><strong>Report bugs</strong> - Contact us through our support channels</li>
    </ul>
    <p>We're committed to keeping T2I simple and reliable for everyone.</p>`,
    id: "get-help"
  }
];

// Generate structured data for FAQ
const structuredData = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "name": "T2I Frequently Asked Questions", 
  "description": "Common questions about T2I text-to-image conversion tool",
  "url": "https://t2i.app/faq",
  "mainEntity": faqData.map(item => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.answer.replace(/<[^>]*>/g, '').replace(/\s+/g, ' ').trim()
    }
  })),
  "publisher": {
    "@type": "Organization",
    "name": "T2I",
    "url": "https://t2i.app"
  }
};

// Export structured data for use in parent page
export { structuredData };
---

<section class="py-16 bg-base-100">
  <div class="container mx-auto px-4">
    <div class="text-center mb-12">
      <h1 class="text-4xl md:text-5xl font-bold text-base-content mb-4">
        Frequently Asked Questions
      </h1>
      <p class="text-lg text-base-content/70 max-w-2xl mx-auto">
        Everything you need to know about T2I - the simple text-to-image conversion tool
      </p>
    </div>

    <div class="max-w-4xl mx-auto">
      <!-- Getting Started Section -->
      <div class="mb-12">
        <h2 class="text-2xl font-semibold text-primary mb-6 flex items-center">
          <svg class="w-6 h-6 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
          </svg>
          Getting Started
        </h2>
        <div class="space-y-3">
          {faqData.filter(item => item.isProminent).map(item => (
            <FAQItem 
              question={item.question}
              answer={item.answer}
              isProminent={item.isProminent}
              id={item.id}
            />
          ))}
        </div>
      </div>

      <!-- Additional Questions -->
      <div class="space-y-6">
        <h2 class="text-2xl font-semibold text-base-content mb-6">
          Features & Support
        </h2>
        <div class="space-y-3">
          {faqData.filter(item => !item.isProminent).map(item => (
            <FAQItem 
              question={item.question}
              answer={item.answer}
              id={item.id}
            />
          ))}
        </div>
      </div>

      <!-- CTA Section -->
      <div class="mt-16 text-center bg-primary/5 rounded-lg p-8">
        <h3 class="text-2xl font-bold text-base-content mb-4">
          Ready to Create Images from Text?
        </h3>
        <p class="text-base-content/70 mb-6">
          No signup required. Start converting your text to PNG images instantly.
        </p>
        <a 
          href="https://create.t2i.app"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-primary btn-lg"
        >
          Start Creating Images →
        </a>
      </div>
    </div>
  </div>
</section>