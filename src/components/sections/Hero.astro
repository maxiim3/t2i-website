---
import Button from '../ui/Button.astro';
---

<section class="hero min-h-screen bg-gradient-to-br from-base-100 to-base-200 flex items-center">
  <div class="hero-content text-center max-w-6xl mx-auto px-4">
    <div class="space-y-8">
      <!-- Main Headline -->
      <div class="space-y-4 animate-fade-in-down">
        <h1 class="text-5xl md:text-7xl font-bold text-base-content leading-tight">
          Convert Text to Images
        </h1>
        <p class="text-xl md:text-2xl text-accent font-semibold">
          (Not AI Art)
        </p>
        <p class="text-lg md:text-xl text-base-content/80 max-w-2xl mx-auto leading-relaxed">
          A simple utility tool that renders your text as PNG, JPG, or WebP images. 
          Perfect for social media graphics, thumbnails, and quotes.
        </p>
      </div>

      <!-- Trust Signals -->
      <div class="flex flex-wrap justify-center gap-6 text-sm text-base-content/60 animate-fade-in animate-delay-200">
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4 text-success" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
          </svg>
          <span>Free</span>
        </div>
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4 text-success" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
          </svg>
          <span>No Signup Required</span>
        </div>
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4 text-success" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
          </svg>
          <span>Privacy-First</span>
        </div>
      </div>

      <!-- Primary CTA -->
      <div class="space-y-4 animate-fade-in-up animate-delay-300">
        <Button 
          href="https://create.t2i.app" 
          variant="primary" 
          size="lg"
          target="_blank"
          class="btn-wide text-lg"
        >
          Start Converting Text →
        </Button>
        <p class="text-sm text-base-content/60">
          No installation required • Works in your browser
        </p>
      </div>

      <!-- Simple Visual Example -->
      <div class="card bg-base-300 shadow-xl max-w-2xl mx-auto mt-12">
        <div class="card-body">
          <h3 class="card-title text-lg mb-4 text-center">How It Works</h3>
          <div class="flex flex-col md:flex-row items-center justify-center gap-6">
            <!-- Input -->
            <div class="text-center">
              <div class="mockup-code text-left bg-base-100 mb-2">
                <pre><code class="text-primary">"Hello World"</code></pre>
              </div>
              <p class="text-sm text-base-content/60">Your Text</p>
            </div>

            <!-- Arrow -->
            <div class="text-primary">
              <svg class="w-8 h-8 transform rotate-90 md:rotate-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
              </svg>
            </div>

            <!-- Output -->
            <div class="text-center">
              <div class="bg-primary text-primary-content px-4 py-3 rounded-lg font-bold mb-2">
                Hello World
              </div>
              <p class="text-sm text-base-content/60">PNG/JPG/WebP Image</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Format Badges -->
      <div class="flex justify-center gap-4">
        <div class="badge badge-primary badge-lg">PNG ✓</div>
        <div class="badge badge-secondary badge-lg opacity-60">JPG Soon</div>
        <div class="badge badge-accent badge-lg opacity-60">WebP Soon</div>
      </div>
    </div>
  </div>
</section>