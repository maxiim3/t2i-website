---
// Features section showcasing T2I's key benefits
---

<section class="py-16 bg-base-100">
  <div class="container mx-auto px-4">
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold text-base-content mb-4">
        Why Choose T2I?
      </h2>
      <p class="text-lg text-base-content/70 max-w-2xl mx-auto">
        A simple, privacy-focused utility tool for converting text into high-quality images
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      <!-- Fast & Simple -->
      <div class="card bg-base-200 shadow-lg hover:shadow-xl transition-shadow animate-fade-in-up animate-delay-100">
        <div class="card-body text-center">
          <div class="mx-auto mb-4 w-12 h-12 bg-primary rounded-full flex items-center justify-center">
            <svg class="w-6 h-6 text-primary-content" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
            </svg>
          </div>
          <h3 class="card-title text-lg justify-center mb-2">Fast & Simple</h3>
          <p class="text-base-content/70 text-sm">
            Convert your text to images in seconds. No complex setup or learning curve required.
          </p>
        </div>
      </div>

      <!-- Multiple Formats -->
      <div class="card bg-base-200 shadow-lg hover:shadow-xl transition-shadow animate-fade-in-up animate-delay-200">
        <div class="card-body text-center">
          <div class="mx-auto mb-4 w-12 h-12 bg-secondary rounded-full flex items-center justify-center">
            <svg class="w-6 h-6 text-secondary-content" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
            </svg>
          </div>
          <h3 class="card-title text-lg justify-center mb-2">Multiple Formats</h3>
          <p class="text-base-content/70 text-sm">
            Export as PNG, JPG, or WebP. Choose the right format for your specific needs.
          </p>
        </div>
      </div>

      <!-- No Account Required -->
      <div class="card bg-base-200 shadow-lg hover:shadow-xl transition-shadow animate-fade-in-up animate-delay-300">
        <div class="card-body text-center">
          <div class="mx-auto mb-4 w-12 h-12 bg-accent rounded-full flex items-center justify-center">
            <svg class="w-6 h-6 text-accent-content" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 11V7a4 4 0 118 0m-4 8v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2z"></path>
            </svg>
          </div>
          <h3 class="card-title text-lg justify-center mb-2">No Account Required</h3>
          <p class="text-base-content/70 text-sm">
            Start converting immediately. No registration, email verification, or personal information needed.
          </p>
        </div>
      </div>

      <!-- Privacy-Focused -->
      <div class="card bg-base-200 shadow-lg hover:shadow-xl transition-shadow animate-fade-in-up animate-delay-400">
        <div class="card-body text-center">
          <div class="mx-auto mb-4 w-12 h-12 bg-success rounded-full flex items-center justify-center">
            <svg class="w-6 h-6 text-success-content" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.031 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
            </svg>
          </div>
          <h3 class="card-title text-lg justify-center mb-2">Privacy-Focused</h3>
          <p class="text-base-content/70 text-sm">
            All processing happens in your browser. Your text and images never leave your device.
          </p>
        </div>
      </div>
    </div>

    <!-- Additional Benefits Row -->
    <div class="mt-12 text-center">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-4xl mx-auto">
        <div class="flex items-center justify-center gap-3">
          <div class="w-2 h-2 bg-primary rounded-full"></div>
          <span class="text-base-content/70">Customizable fonts & colors</span>
        </div>
        <div class="flex items-center justify-center gap-3">
          <div class="w-2 h-2 bg-secondary rounded-full"></div>
          <span class="text-base-content/70">Transparent backgrounds</span>
        </div>
        <div class="flex items-center justify-center gap-3">
          <div class="w-2 h-2 bg-accent rounded-full"></div>
          <span class="text-base-content/70">Perfect for social media</span>
        </div>
      </div>
    </div>
  </div>
</section>