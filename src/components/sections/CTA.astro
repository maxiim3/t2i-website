---
import Button from '../ui/Button.astro';
---

<section class="py-16 bg-gradient-to-br from-primary/5 to-accent/5">
  <div class="container mx-auto px-4 text-center">
    <div class="max-w-3xl mx-auto space-y-8">
      <!-- Main CTA Headline -->
      <div class="space-y-4">
        <h2 class="text-3xl md:text-5xl font-bold text-base-content">
          Ready to Convert Your Text?
        </h2>
        <p class="text-lg md:text-xl text-base-content/70">
          Join thousands of users creating images from text every day. 
          Start converting in seconds - no signup required.
        </p>
      </div>

      <!-- Key Benefits Reminder -->
      <div class="flex flex-wrap justify-center gap-6 text-sm text-base-content/60">
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4 text-success" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
          </svg>
          <span>100% Free</span>
        </div>
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4 text-success" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
          </svg>
          <span>No Account Needed</span>
        </div>
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4 text-success" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
          </svg>
          <span>Privacy Protected</span>
        </div>
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4 text-success" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
          </svg>
          <span>Multiple Formats</span>
        </div>
      </div>

      <!-- Primary CTA Button -->
      <div class="space-y-4">
        <Button 
          href="https://create.t2i.app" 
          variant="primary" 
          size="lg"
          target="_blank"
          class="btn-wide text-lg shadow-lg"
        >
          Start Creating Images Now →
        </Button>
        <p class="text-sm text-base-content/60">
          Works instantly in your browser • No download required
        </p>
      </div>

      <!-- Secondary Information -->
      <div class="border-t border-base-content/10 pt-8">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-center">
          <div>
            <div class="text-2xl font-bold text-primary mb-2">3 Formats</div>
            <div class="text-sm text-base-content/60">PNG, JPG, WebP</div>
          </div>
          <div>
            <div class="text-2xl font-bold text-secondary mb-2">Zero Setup</div>
            <div class="text-sm text-base-content/60">Ready in seconds</div>
          </div>
          <div>
            <div class="text-2xl font-bold text-accent mb-2">100% Private</div>
            <div class="text-sm text-base-content/60">Client-side processing</div>
          </div>
        </div>
      </div>

      <!-- Not AI Art Reminder -->
      <div class="bg-base-200 rounded-lg p-6 max-w-xl mx-auto">
        <div class="flex items-center justify-center gap-3 mb-2">
          <svg class="w-5 h-5 text-info" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          <span class="font-semibold text-info">This is NOT an AI art generator</span>
        </div>
        <p class="text-sm text-base-content/70">
          T2I is a simple utility tool that renders your text as images. 
          No artificial intelligence, no artistic interpretation - just your text converted to image format.
        </p>
      </div>

      <!-- Final Encouragement -->
      <div class="text-center">
        <p class="text-base-content/60 text-sm">
          Perfect for social media managers, developers, content creators, and anyone who needs text as images.
        </p>
      </div>
    </div>
  </div>
</section>