---
import { cn } from '../lib/utils';

// Test data for demonstrating dynamic classes
const testVariants = {
  primary: 'btn-primary',
  secondary: 'btn-secondary',
  accent: 'btn-accent',
  ghost: 'btn-ghost'
} as const;
---

<div class="container mx-auto px-4 py-8 space-y-8">
  <!-- Header -->
  <div class="text-center space-y-2">
    <h1 class="text-4xl font-bold text-base-content">
      T2I Development Foundation Test
    </h1>
    <p class="text-lg text-base-content/70">
      Validating Astro + Tailwind v4 + daisyUI + cn utility
    </p>
  </div>

  <!-- Tailwind Utility Classes Test -->
  <section class="card bg-base-100 shadow-xl">
    <div class="card-body">
      <h2 class="card-title text-2xl">✅ Tailwind CSS v4 Utilities</h2>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <div class="p-4 bg-primary text-primary-content rounded-lg text-center">
          Primary
        </div>
        <div class="p-4 bg-secondary text-secondary-content rounded-lg text-center">
          Secondary
        </div>
        <div class="p-4 bg-accent text-accent-content rounded-lg text-center">
          Accent
        </div>
        <div class="p-4 bg-neutral text-neutral-content rounded-lg text-center">
          Neutral
        </div>
      </div>
      <p class="text-sm text-base-content/60 mt-2">
        Testing: colors, spacing, responsive grid, text utilities
      </p>
    </div>
  </section>

  <!-- daisyUI Components Test -->
  <section class="card bg-base-100 shadow-xl">
    <div class="card-body">
      <h2 class="card-title text-2xl">✅ daisyUI Components</h2>
      
      <!-- Button variations -->
      <div class="flex flex-wrap gap-2 mb-4">
        <button class="btn btn-primary">Primary</button>
        <button class="btn btn-secondary">Secondary</button>
        <button class="btn btn-accent">Accent</button>
        <button class="btn btn-ghost">Ghost</button>
        <button class="btn btn-outline">Outline</button>
      </div>

      <!-- Badge components -->
      <div class="flex flex-wrap gap-2 mb-4">
        <div class="badge badge-primary">Primary</div>
        <div class="badge badge-secondary">Secondary</div>
        <div class="badge badge-accent">Accent</div>
        <div class="badge badge-outline">Outline</div>
      </div>

      <!-- Alert component -->
      <div class="alert alert-info">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="stroke-current shrink-0 w-6 h-6">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
        <span>daisyUI alert component working correctly!</span>
      </div>

      <p class="text-sm text-base-content/60 mt-2">
        Testing: buttons, badges, alerts, card layout
      </p>
    </div>
  </section>

  <!-- cn Utility Test -->
  <section class="card bg-base-100 shadow-xl">
    <div class="card-body">
      <h2 class="card-title text-2xl">✅ cn Utility Function</h2>
      
      <!-- Test class merging and conflicts -->
      <div class="space-y-4">
        <div class={cn("p-4 rounded-lg", "bg-primary text-primary-content", "hover:bg-primary-focus")}>
          Basic class merging with cn()
        </div>
        
        <div class={cn(
          "btn",
          testVariants.secondary,
          "btn-lg",
          true && "shadow-lg",
          false && "btn-disabled"
        )}>
          Dynamic classes with conditionals
        </div>
        
        <!-- Test conflict resolution -->
        <div class={cn("p-2 p-4 bg-red-500 bg-blue-500 text-white")}>
          Conflict resolution: p-4 and bg-blue-500 should win
        </div>
      </div>

      <p class="text-sm text-base-content/60 mt-2">
        Testing: class merging, conditionals, conflict resolution (tailwind-merge)
      </p>
    </div>
  </section>

  <!-- Responsive Design Test -->
  <section class="card bg-base-100 shadow-xl">
    <div class="card-body">
      <h2 class="card-title text-2xl">✅ Responsive Design</h2>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        <div class="card bg-primary text-primary-content">
          <div class="card-body">
            <h3 class="card-title text-lg">Mobile</h3>
            <p class="text-sm">Full width</p>
          </div>
        </div>
        <div class="card bg-secondary text-secondary-content">
          <div class="card-body">
            <h3 class="card-title text-lg">Tablet</h3>
            <p class="text-sm">Half width</p>
          </div>
        </div>
        <div class="card bg-accent text-accent-content">
          <div class="card-body">
            <h3 class="card-title text-lg">Desktop</h3>
            <p class="text-sm">Third width</p>
          </div>
        </div>
      </div>

      <p class="text-sm text-base-content/60 mt-2">
        Testing: responsive breakpoints, mobile-first approach
      </p>
    </div>
  </section>

  <!-- TypeScript Integration Test -->
  <section class="card bg-base-100 shadow-xl">
    <div class="card-body">
      <h2 class="card-title text-2xl">✅ TypeScript Integration</h2>
      
      <div class="mockup-code">
        <pre data-prefix="1"><code>// cn utility with TypeScript</code></pre>
        <pre data-prefix="2"><code>import { cn } from '../lib/utils';</code></pre>
        <pre data-prefix="3"><code></code></pre>
        <pre data-prefix="4"><code>// Type-safe class merging</code></pre>
        <pre data-prefix="5"><code>const classes = cn('btn', 'btn-primary');</code></pre>
      </div>

      <p class="text-sm text-base-content/60 mt-2">
        Testing: TypeScript types, imports, no type errors
      </p>
    </div>
  </section>

  <!-- Foundation Success Summary -->
  <section class="card bg-success text-success-content shadow-xl">
    <div class="card-body">
      <h2 class="card-title text-2xl">🎉 Foundation Setup Complete</h2>
      <div class="space-y-2">
        <p>✅ Astro dev server running successfully</p>
        <p>✅ Tailwind v4 CSS imports working</p>
        <p>✅ daisyUI components rendering properly</p>
        <p>✅ cn utility function working for class merging</p>
        <p>✅ TypeScript integration working</p>
        <p>✅ Responsive design functional</p>
      </div>
      <div class="card-actions justify-end mt-4">
        <a href="https://create.t2i.app" class="btn btn-primary btn-lg" target="_blank" rel="noopener noreferrer">
          Go to T2I App →
        </a>
      </div>
    </div>
  </section>
</div>

<style>
  /* Any additional custom styles if needed - prefer Tailwind classes */
</style>