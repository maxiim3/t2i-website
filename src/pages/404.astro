---
import Layout from '../layouts/Layout.astro';

const title = "Page Not Found - T2I";
const description = "The page you're looking for doesn't exist. Return to T2I homepage to continue converting text to images.";
---

<Layout 
  title={title}
  description={description}
  noindex={true}
  ogType="website"
  ogTitle={title}
  ogDescription={description}
>
  <main class="flex-1 flex items-center justify-center py-16">
    <div class="container mx-auto px-4 text-center">
      <div class="max-w-2xl mx-auto space-y-8">
        <!-- Error Visual -->
        <div class="space-y-6">
          <div class="text-8xl md:text-9xl font-bold text-primary/20">
            404
          </div>
          
          <!-- Error Message -->
          <div class="space-y-4">
            <h1 class="text-3xl md:text-4xl font-bold text-base-content">
              Page Not Found
            </h1>
            <p class="text-lg text-base-content/70 max-w-md mx-auto">
              Sorry, we couldn't find the page you're looking for. The link might be broken or the page may have been moved.
            </p>
          </div>
        </div>

        <!-- Navigation Options -->
        <div class="space-y-6">
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <!-- Homepage -->
            <a 
              href="/"
              class="card bg-base-200 hover:bg-base-300 transition-colors p-6"
            >
              <div class="text-center">
                <div class="w-12 h-12 bg-primary rounded-full flex items-center justify-center mx-auto mb-3">
                  <svg class="w-6 h-6 text-primary-content" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
                  </svg>
                </div>
                <h3 class="font-semibold text-base-content mb-2">Homepage</h3>
                <p class="text-sm text-base-content/60">Learn about T2I and start converting text to images</p>
              </div>
            </a>

            <!-- Text-to-PNG -->
            <a 
              href="/text-to-png"
              class="card bg-base-200 hover:bg-base-300 transition-colors p-6"
            >
              <div class="text-center">
                <div class="w-12 h-12 bg-secondary rounded-full flex items-center justify-center mx-auto mb-3">
                  <svg class="w-6 h-6 text-secondary-content" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                  </svg>
                </div>
                <h3 class="font-semibold text-base-content mb-2">Text-to-PNG</h3>
                <p class="text-sm text-base-content/60">Convert your text to PNG images with transparency</p>
              </div>
            </a>

            <!-- FAQ -->
            <a 
              href="/faq"
              class="card bg-base-200 hover:bg-base-300 transition-colors p-6"
            >
              <div class="text-center">
                <div class="w-12 h-12 bg-accent rounded-full flex items-center justify-center mx-auto mb-3">
                  <svg class="w-6 h-6 text-accent-content" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                  </svg>
                </div>
                <h3 class="font-semibold text-base-content mb-2">FAQ</h3>
                <p class="text-sm text-base-content/60">Find answers to common questions about T2I</p>
              </div>
            </a>
          </div>

          <!-- Primary CTA -->
          <div class="pt-4">
            <a 
              href="https://create.t2i.app"
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-primary btn-lg"
            >
              Start Creating Images →
            </a>
          </div>

          <!-- Additional Help -->
          <div class="text-sm text-base-content/60 pt-4">
            <p>Still having trouble? Try refreshing the page or check our <a href="/faq" class="link link-primary">FAQ section</a>.</p>
          </div>
        </div>
      </div>
    </div>
  </main>
</Layout>